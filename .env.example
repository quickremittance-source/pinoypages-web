# Copy to .env.local (git-ignored). Unset = results pages and admin table are switched off (404).
ANALYTICS_SECRET=   # long random string; signs /results/<id>?t=... links
ADMIN_KEY=          # long random string; /admin/analytics?key=...
ANALYTICS_STORE=json  # json | memory | upstash | neon (upstash/neon not provisioned)
# ANALYTICS_FILE=data/analytics.json
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Postgres (Neon). Linked to Vercel Preview only; local falls back to data/submissions.jsonl.
# DATABASE_URL=
