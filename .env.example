# Copy to .env.local (git-ignored). Unset = results pages and admin table are switched off (404).
ANALYTICS_SECRET=   # long random string; signs /results/<id>?t=... links
ADMIN_KEY=          # long random string; /admin/analytics?key=...
ANALYTICS_STORE=json  # json | memory | upstash | neon (upstash/neon not provisioned)
# ANALYTICS_FILE=data/analytics.json
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Inquiry notification (one path only). OFF unless exactly "true" AND Jose has approved turning it on.
# Sender is fixed: PinoyPages <info@pinoypages.ca>; recipient fixed: pinoypagesca@gmail.com; reply-to = submitter.
INQUIRY_NOTIFY_ENABLED=false
# BREVO_API_KEY=   # Vercel env only; never commit
